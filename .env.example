# ==============================================================================
# CONFIGURACIÓN DEL AUDITOR AGÉNTICO DE FACTURACIÓN DE SINIESTROS
# ==============================================================================

# API Key de Google Gemini
# Consigue una en: https://aistudio.google.com/
GEMINI_API_KEY=

# Modelo de Gemini a utilizar (Recomendado: gemini-1.5-pro o gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-pro

# Token de Integración Interna de Notion
# Consigue uno en: https://www.notion.so/my-integrations
NOTION_TOKEN=

# ID de la Base de Datos de Tarifario (Ver guía en README.md)
NOTION_TARIFARIO_DB_ID=

# ID de la Base de Datos de Historial (Ver guía en README.md)
NOTION_HISTORIAL_DB_ID=
